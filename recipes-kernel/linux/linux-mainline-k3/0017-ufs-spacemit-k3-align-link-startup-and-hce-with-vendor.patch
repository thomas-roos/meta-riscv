From: Thomas Roos <thomas@exein.io>
Subject: [PATCH] scsi: ufs: spacemit: k3: align link startup and HCE with vendor

Still on the K3 CoM260 IFX bring-up: with the vendor M-PHY sequence the
link comes up partially but descriptor queries fail (-5) and error
recovery cannot re-enable the controller. Align three more spots with the
SpacemiT vendor driver:
- PA link startup timer = sys1clk_1us * 100000 instead of 0xFFFFFFF0
- hce_enable_notify: disable a still-enabled controller before re-enable
  (U-Boot leaves it enabled; also used by error recovery)
- no UFSHCD_CAP_RPM_AUTOSUSPEND (vendor leaves runtime PM off)

Upstream-Status: Pending
Signed-off-by: Thomas Roos <thomas@exein.io>
---
--- a/drivers/ufs/host/ufs-spacemit.c
+++ b/drivers/ufs/host/ufs-spacemit.c
@@ -272,17 +272,16 @@
 	if (err < 0)
 		return err;
 
-	/* config sysclk and tx symbol clk before link startup */
-	value = UFS_MAX_LINKSTARTUP_TIMER;
-
-	/* clear bit0~bit3, select b0 design */
-	value &= ~0xf;
-
-	ufshcd_writel(hba, value, UFS_PA_LINK_STARTUP_TIMER);
-
 	sys1clk_1us = ufs_spacemit_get_sys1clk_1us(hba);
 	if (!sys1clk_1us)
 		sys1clk_1us = DIV_ROUND_CLOSEST(UFS_AXI_CLK_LOW_FREQ_HZ, 1000000);
+
+	/*
+	 * Link startup timer as in the vendor driver: 100000 sys1clk_1us
+	 * ticks. Clear bit0~bit3 to select the b0 design.
+	 */
+	value = (sys1clk_1us * 100000) & ~0xf;
+	ufshcd_writel(hba, value, UFS_PA_LINK_STARTUP_TIMER);
 	ufshcd_writel(hba, sys1clk_1us, UFS_SYS1CLK_1US);
 	ufshcd_writel(hba, UFS_TX_SYMBO_CLK, UFS_TX_SYMBOL_CLK_NS_US);
 
@@ -459,7 +458,6 @@
 	ufshcd_set_variant(hba, host);
 	ufs_spacemit_advertise_quirks(hba);
 
-	hba->caps |= UFSHCD_CAP_RPM_AUTOSUSPEND;
 
 	return 0;
 }
@@ -472,6 +470,31 @@
  *
  * Returns: 0 on success
  */
+static int ufs_spacemit_hce_enable_notify(struct ufs_hba *hba,
+					  enum ufs_notify_change_status status)
+{
+	static bool is_first_hce = true;
+	u32 val;
+
+	if (status != PRE_CHANGE)
+		return 0;
+
+	if (is_first_hce) {
+		is_first_hce = false;
+		return 0;
+	}
+
+	if (ufshcd_readl(hba, REG_CONTROLLER_ENABLE) & CONTROLLER_ENABLE) {
+		ufshcd_writel(hba, CONTROLLER_DISABLE, REG_CONTROLLER_ENABLE);
+		if (readl_poll_timeout_atomic(hba->mmio_base + REG_CONTROLLER_ENABLE,
+					      val, !(val & CONTROLLER_ENABLE),
+					      1, 10000))
+			dev_err(hba->dev, "%s: controller disable timeout\n", __func__);
+	}
+
+	return 0;
+}
+
 static int ufs_spacemit_device_reset(struct ufs_hba *hba)
 {
 	/* Disable reference clock & asserted ufs device reset */
@@ -616,6 +639,7 @@
 	.negotiate_pwr_mode = ufs_spacemit_negotiate_pwr_mode,
 	.pwr_change_notify = ufs_spacemit_pwr_change_notify,
 	.device_reset = ufs_spacemit_device_reset,
+	.hce_enable_notify = ufs_spacemit_hce_enable_notify,
 	.event_notify = ufs_spacemit_event_notify,
 	.apply_dev_quirks = ufs_spacemit_apply_dev_quirks,
 	.hibern8_notify = ufs_spacemit_hibern8_notify,
